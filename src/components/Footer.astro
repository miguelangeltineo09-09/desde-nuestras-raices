	<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-10 text-center">
		<a href="/" class="flex items-center gap-3">
			<img src={logo.src} alt="Desde Nuestras Raíces" class="h-8 w-auto" />
			<span class="font-heading text-base font-semibold text-crema">Desde Nuestras Raíces</span>
		</a>

		<p class="font-heading text-sm italic text-crema/90">Donde otros no miran, nosotros llegamos.</p>

