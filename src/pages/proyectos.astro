---
import BaseLayout from '../layouts/BaseLayout.astro';

const proyectos = [
	{
		icon: '🥘',
		nombre: 'Mesa Solidaria',
		subtitulo: 'Alimentación familiar',
		descripcion:
			'Una iniciativa de recolección y distribución de alimentos básicos para apoyar a los hogares identificados mediante nuestro trabajo comunitario.',
		objetivo: 'contribuir a que más familias tengan acceso a alimentos esenciales.',
		sostenimiento: 'Mediante donaciones de alimentos, campañas solidarias y alianzas con comercios.',
		accentColor: 'bg-oliva',
		bgColor: 'bg-oliva-suave',
	},
	{
		icon: '🎒',
		nombre: 'Mochilas con Futuro',
		subtitulo: 'Educación infantil',
		descripcion:
			'Una campaña que busca reunir mochilas, cuadernos, lápices y otros materiales para estudiantes que necesitan apoyo escolar.',
		objetivo:
			'contribuir a que las dificultades económicas no sean un obstáculo para contar con los materiales educativos básicos.',
		sostenimiento: 'Con colectas escolares, donaciones de papelerías y aportes de la comunidad.',
		accentColor: 'bg-terracota',
		bgColor: 'bg-terracota-suave',
	},
	{
		icon: '🩺',
		nombre: 'Salud Cercana',
		subtitulo: 'Bienestar y orientación sanitaria',
		descripcion:
			'Jornadas coordinadas con profesionales y centros de salud para ofrecer información sanitaria y orientar a las familias sobre los servicios disponibles.',
		objetivo: 'facilitar el acceso a información y orientación sobre salud.',
		sostenimiento: 'Mediante alianzas con centros sanitarios, profesionales autorizados y colaboradores.',
		accentColor: 'bg-amarillo',
		bgColor: 'bg-amarillo-suave',
	},
];
---

<BaseLayout
	title="Proyectos | Desde Nuestras Raíces"
	description="Conoce los proyectos de Desde Nuestras Raíces: Mesa Solidaria, Mochilas con Futuro y Salud Cercana."
>
	<section class="px-6 pt-16 text-center md:pt-20">
		<p class="text-sm font-semibold tracking-widest text-oliva">PROYECTOS</p>
		<h2 class="mt-4 font-heading text-3xl font-bold text-marron md:text-4xl">Nuestros proyectos</h2>
		<p class="mt-4 text-base text-marron/70 md:text-lg">Iniciativas concretas a través de las cuales trabajamos.</p>
	</section>

	<section class="px-6 py-12 md:py-20">
		<div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-3">
			{proyectos.map((proyecto, i) => (
				<div class={`reveal flex flex-col rounded-2xl p-6 ${proyecto.bgColor}`} style={`transition-delay: ${i * 80}ms`}>
					<div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl text-2xl ${proyecto.accentColor}`}>
						<span aria-hidden="true">{proyecto.icon}</span>
					</div>
					<h3 class="font-heading text-lg font-semibold text-marron">{proyecto.nombre}</h3>
					<p class="mt-1 text-sm font-medium text-oliva">{proyecto.subtitulo}</p>
					<p class="mt-3 text-sm text-marron/80">{proyecto.descripcion}</p>
					<p class="mt-3 text-sm text-marron/80"><span class="font-semibold text-marron">Objetivo:</span> {proyecto.objetivo}</p>
					<p class="mt-3 text-sm text-marron/80">
						<span class="font-semibold text-marron">¿Cómo se sostiene?</span> {proyecto.sostenimiento}
					</p>
				</div>
			))}
		</div>
	</section>
</BaseLayout>
